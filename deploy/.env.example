# PostgreSQL
POSTGRES_USER=app
POSTGRES_PASSWORD=changeme
POSTGRES_DB=appdb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=changeme
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/

# Celery
CELERY_BROKER_URL=amqp://admin:changeme@rabbitmq:5672/
CELERY_RESULT_BACKEND=redis://redis:6379/0

# FastAPI
APP_ENV=production
LOG_LEVEL=info
SECRET_KEY=changeme
